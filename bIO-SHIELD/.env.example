SECRET_KEY=replace-with-a-random-50-character-secret-key-before-use
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],bioshield.local
DB_NAME=bioshield
DB_USER=bioshield
DB_PASSWORD=change-this-database-password
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_REFERRER_POLICY=same-origin
SECURE_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), interest-cohort=()
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
SECURE_CROSS_ORIGIN_RESOURCE_POLICY=same-origin
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
API_THROTTLE_ANON=5/min
API_THROTTLE_USER=120/min
MAX_UPLOAD_SIZE_MB=10
RETENTION_DAYS=365
SYNTHETIC_DATA_ONLY=True
ENABLE_PRESIDIO=True
ENABLE_SPACY_MODEL=True
FIELD_ENCRYPTION_KEY=
AI_MODEL_PATH=
RISK_MODEL_PATH=
SCAN_TIMEOUT_SECONDS=120
